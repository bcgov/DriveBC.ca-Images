{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>bcgov/renovate-config#2026.10.29"
  ],
  "packageRules": [
    {
      "description": "Disable automerge for major updates",
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "Disable automerge for Python runtime and container updates",
      "matchPackageNames": ["python", "actions/python-versions"],
      "matchDatasources": ["docker", "github-releases"],
      "automerge": false
    }
  ]
}
